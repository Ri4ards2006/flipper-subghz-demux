# ==============================================================================
# flipper-subghz-demux Environment Configuration (Template)
# Copy to .env and fill in your local values. NEVER commit .env to Git.
# ==============================================================================

# --- UART / Flipper Zero Serial Link (REQUIRED) ---
# UART_DEVICE=/dev/serial0
# UART_BAUD=115200

# --- MQTT Broker Target (REQUIRED) ---
# MQTT_BROKER=tcp://mqtt.example.local:1883
# MQTT_TOPIC_PREFIX=rf/subghz
# MQTT_CLIENT_ID=flipper-subghz-demux
# MQTT_USERNAME=your_mqtt_user
# MQTT_PASSWORD=your_mqtt_password

# --- Runtime Tuning ---
# WORKER_COUNT=2
# QUEUE_SIZE=512
# LOG_LEVEL=info
